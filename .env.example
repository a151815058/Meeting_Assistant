# Flask
FLASK_APP=run.py
FLASK_ENV=development
# Passwordless local login when OAuth credentials are not set up (development only, localhost only)
DEV_LOGIN_ENABLED=true
SECRET_KEY=change-me-to-a-random-value

# Database
DATABASE_URL=postgresql+psycopg2://meeting_assistant:change-me@localhost:5432/meeting_assistant

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# SocketIO message queue: only needed with multiple web processes / Celery emitting events.
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

# Field-level encryption for stored OAuth refresh tokens (Fernet key, 32-byte urlsafe base64)
TOKEN_ENCRYPTION_KEY=generate-with-cryptography-fernet-generate-key

# Google OAuth (Calendar readonly + Gmail send scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Microsoft OAuth (Graph: Calendars.Read, Mail.Send)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback

# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=high
LLM_MAX_OUTPUT_TOKENS=32000
# Re-run safety-declined requests on Anthropic's recommended fallback model (server-side)
LLM_FALLBACKS_ENABLED=true
# Transcripts whose prompt exceeds this are summarised chunk by chunk first
MINUTES_MAX_INPUT_TOKENS=600000
MINUTES_CHUNK_TOKENS=150000

# Time zone for displayed times; calendar events offered on "new meeting"
DISPLAY_TIMEZONE=Asia/Taipei
CALENDAR_LOOKBACK_HOURS=24
CALENDAR_LOOKAHEAD_DAYS=14
CALENDAR_MAX_EVENTS=50

# Sending minutes (as the organizer via Gmail API / Microsoft Graph)
MAIL_MAX_RECIPIENTS=100
# Only 429 / 503 responses are retried automatically (a connection error may already have delivered)
MAIL_SEND_ATTEMPTS=3
MAIL_RETRY_BACKOFF_SECONDS=2
MAIL_RESEND_COOLDOWN_SECONDS=60
# Word/PDF attachments together (Graph sendMail rejects requests over ~4 MB)
MAIL_MAX_ATTACHMENT_BYTES=3000000
# PDF export font with Traditional Chinese glyphs; empty = auto-detect (Windows JhengHei / fonts-noto-cjk)
# PDF_FONT_PATH=C:\Windows\Fonts\msjh.ttc
# PDF_BOLD_FONT_PATH=C:\Windows\Fonts\msjhbd.ttc
# Development only: organizers without a mail-capable OAuth account get .eml files here instead
MAIL_OUTBOX_ENABLED=true
# MAIL_OUTBOX_DIR=instance/outbox

# Faster-Whisper model
# small = real-time on CPU; medium is more accurate but ~3x slower than real time on CPU (GPU recommended)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
WHISPER_LANGUAGE=zh
WHISPER_INITIAL_PROMPT=以下是繁體中文的會議逐字稿。

# Real-time transcription limits
TRANSCRIPTION_MAX_CHUNK_BYTES=32000
TRANSCRIPTION_MAX_BYTES_PER_SECOND=64000
TRANSCRIPTION_MAX_RECORDING_SECONDS=14400
TRANSCRIPTION_LAG_WARNING_SECONDS=30
# Uploaded recordings: max file size (bytes); the file is deleted once transcribed
TRANSCRIPTION_UPLOAD_MAX_BYTES=524288000

# Speaker diarization (optional, requires: pip install -r requirements-diarization.txt)
DIARIZATION_ENABLED=false
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
HF_TOKEN=
